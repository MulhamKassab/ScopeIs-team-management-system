{
  "name": "scopeis-team-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:safe": "node scripts/run-phase2-safe-build.mjs",
    "build:phase1-certification": "node scripts/run-phase1-safe-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:migration && npm run test:route-certification && npm run test:seed-smoke && npm run test:isolation && npm run build:safe && npm run test:e2e",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run test/component",
    "test:integration": "node scripts/run-aggregate-integration-tests.mjs",
    "test:e2e": "node scripts/run-aggregate-e2e-tests.mjs",
    "test:route-certification": "node scripts/run-phase1-route-certification.mjs",
    "test:migration": "node scripts/run-phase2-migration-tests.mjs",
    "test:seed-smoke": "node scripts/run-seed-smoke.mjs",
    "test:isolation": "node scripts/verify-isolation.mjs",
    "test:phase1-integration": "node scripts/run-phase1-integration-tests.mjs",
    "test:phase1-e2e": "node scripts/run-phase1-playwright.mjs",
    "test:phase2-core": "node scripts/run-phase2-core-service-tests.mjs",
    "test:phase2-e2e": "node scripts/run-phase2-playwright.mjs",
    "test:phase3-service": "node scripts/run-phase3-service-tests.mjs",
    "test:phase3-e2e": "node scripts/run-phase3-playwright.mjs",
    "test:phase4-service": "node scripts/run-phase4-service-tests.mjs",
    "test:phase4-e2e": "node scripts/run-phase4-playwright.mjs",
    "test:phase5-service": "node scripts/run-phase5-service-tests.mjs",
    "test:phase5-e2e": "node scripts/run-phase5-playwright.mjs",
    "test:phase6-service": "node scripts/run-phase6-service-tests.mjs",
    "test:phase6-e2e": "node scripts/run-phase6-playwright.mjs",
    "test:phase7-service": "node scripts/run-phase7-service-tests.mjs",
    "test:phase7-e2e": "node scripts/run-phase7-playwright.mjs",
    "test:phase8-service": "node scripts/run-phase8-service-tests.mjs",
    "test:phase8-e2e": "node scripts/run-phase8-playwright.mjs",
    "test:phase9-service": "node scripts/run-phase9-service-tests.mjs",
    "test:phase9-e2e": "node scripts/run-phase9-playwright.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:migrate:test": "tsx --env-file=.env.test ./node_modules/drizzle-kit/bin.cjs migrate --config drizzle.test.config.ts",
    "db:migration:inspect": "node scripts/run-phase2-migration-command.mjs inspect",
    "db:migration:reconcile": "node scripts/run-phase2-migration-command.mjs reconcile",
    "db:migration:reconcile:apply": "node scripts/run-phase2-migration-command.mjs reconcile --apply",
    "db:migration:validate": "node scripts/run-phase2-migration-command.mjs validate",
    "db:migration:clean-install:validate": "node scripts/run-phase2-migration-tests.mjs -t \"clean normal migration\"",
    "db:schema:export": "drizzle-kit export --config=drizzle.certification.config.ts",
    "db:schema:drift": "node scripts/run-phase2-migration-tests.mjs -t \"detects migration\"",
    "db:schema:runtime:validate": "node scripts/run-phase2-migration-tests.mjs -t \"uses all eight\"",
    "db:validate": "tsx src/db/validate.ts",
    "audit:dependencies": "npm audit --omit=dev"
    ,"validate:phase2-runbook": "node scripts/validate-phase2-runbook.mjs",
    "test:phase10-service": "node scripts/run-phase10-service-tests.mjs",
    "test:phase10-e2e": "node scripts/run-phase10-playwright.mjs"
    ,"test:phase11-service": "node scripts/run-phase11-service-tests.mjs"
    ,"test:account-administration": "node scripts/run-account-administration-service-tests.mjs"
    ,"test:account-administration-e2e": "node scripts/run-account-e2e.mjs"
    ,"test:phase11-e2e": "node scripts/run-phase11-playwright.mjs",
    "test:system-smoke": "node scripts/run-system-smoke.mjs",
    "test:system-concurrency": "node scripts/run-system-concurrency-tests.mjs",
    "test:system-lock": "node scripts/run-system-lock.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.0",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^29.0.1",
    "typescript": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}

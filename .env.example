# Development-only local PostgreSQL database. Never use a production URL here.
DATABASE_URL=postgresql://localhost:5432/scopeis_team_management_dev
APP_ENV=development
MOCK_AUTH_ENABLED=true
SESSION_TTL_HOURS=12
# Optional absolute PRIVATE directory for development uploads to survive app restarts.
# Leave unset for temporary local storage. Production never permits local storage.
# EVIDENCE_LOCAL_DIRECTORY=C:/Users/your-user/AppData/Local/ScopeIsLocal/private-files
